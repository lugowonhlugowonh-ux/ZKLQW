local function ButtonHover(Button)
    Button.MouseEnter:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(50, 50, 58)}
        ):Play()
    end)

    Button.MouseLeave:Connect(function()
        TweenService:Create(
            Button,
            TweenInfo.new(0.15),
            {BackgroundColor3 = Color3.fromRGB(30, 30, 36)}
        ):Play()
    end)
end

ButtonHover(CheckButton)
ButtonHover(GetButton)

CheckButton.MouseButton1Click:Connect(function()
    local Key = KeyBox.Text:gsub("%s+", "")

    if Key == "" then
        Status.Text = "Status: Enter a key."
        Status.TextColor3 = Color3.fromRGB(255, 180, 80)
        return
    end

    if VALID_KEYS[Key] then
        Status.Text = "Status: Key accepted."
        Status.TextColor3 = Color3.fromRGB(100, 255, 140)

        task.wait(0.6)

        ScreenGui.Enabled = false
        LoadMainUI()
        ScreenGui:Destroy()
    else
        Status.Text = "Status: Invalid key."
        Status.TextColor3 = Color3.fromRGB(255, 90, 90)
        KeyBox.Text = ""
    end
end)

GetButton.MouseButton1Click:Connect(function()
