local function CreateParticle()
    local Particle = Instance.new("Frame")
    local Size = math.random(2, 5)

    Particle.Size = UDim2.new(0, Size, 0, Size)
    Particle.Position = UDim2.new(math.random(), 0, 1.1, 0)
    Particle.BackgroundColor3 = Color3.fromHSV(math.random(), 0.9, 1)
    Particle.BackgroundTransparency = math.random(1, 4) / 10
    Particle.BorderSizePixel = 0
    Particle.ZIndex = 1
    Particle.Parent = ParticleContainer

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Particle

    local Glow = Instance.new("UIStroke")
    Glow.Thickness = 1
    Glow.Transparency = 0.2
    Glow.Color = Particle.BackgroundColor3
    Glow.Parent = Particle

    local Duration = math.random(4, 8)

    local Tween = TweenService:Create(
        Particle,
        TweenInfo.new(Duration, Enum.EasingStyle.Linear),
        {
            Position = UDim2.new(math.random(), 0, -0.15, 0),
            BackgroundTransparency = 1
        }
    )

    Tween:Play()
    Tween.Completed:Connect(function()
        Particle:Destroy()
    end)
end

task.spawn(function()
    while ScreenGui.Parent do
        CreateParticle()
        task.wait(0.12)
    end
end)

